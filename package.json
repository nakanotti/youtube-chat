{
  "name": "youtube-chat",
  "version": "2.2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": "https://github.com/LinaTsukusu/youtube-chat.git",
  "author": "LinaTsukusu <lina.tsukusu@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.12.0"
  },
  "private": false,
  "scripts": {
    "build": "tsc",
    "debug": "node --require ts-node/register src/debug.ts",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format-check": "prettier --check \"{src,test}/**/*.ts\"",
    "check-supply-chain": "node scripts/check-supply-chain.js",
    "check-updates": "npm outdated --depth=0",
    "audit-security": "npm audit --audit-level=moderate",
    "audit-signatures": "npm audit signatures",
    "update-dev-environment": "bash scripts/update-dev-environment.sh",
    "update-modules-safe": "bash scripts/update-modules-safe.sh"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "keywords": [
    "youtube",
    "live",
    "chat",
    "comment",
    "stream"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.12.1",
    "jest": "^30.4.2",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "typed-emitter": "^2.1.0"
  },
  "overrides": {
    "test-exclude": "^8.0.0"
  }
}
